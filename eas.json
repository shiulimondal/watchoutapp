{
    "cli": {
        "version": ">= 11.0.3",
        "appVersionSource": "remote"
    },
    "build": {
        "development": {
            "developmentClient": true,
            "distribution": "internal",
            "android": {
                "buildType": "apk"
            },
            "env": {
                "EXPO_PUBLIC_URL": "https://watchoutonline.in/api/v1"
            }
        },
        "preview": {
            "distribution": "internal",
            "env": {
                "EXPO_PUBLIC_URL": "https://watchoutonline.in/api/v1"
            }
        },
        "production": {
            "android": {
                "buildType": "app-bundle"
            },
            "env": {
                "EXPO_PUBLIC_URL": "https://watchoutonline.in/api/v1"
            },
            "autoIncrement": true
        }
    },
    "submit": {
        "production": {}
    }
}